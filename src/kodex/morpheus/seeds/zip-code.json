    "after_shape": "##-###"
  },
  "prompt_snippet": "Polski „Kod pocztowy” ma format NN-NNN (myślnik po drugiej cyfrze): walidator ZIP_CODE. Kod pocztowy zagraniczny: bez ZIP_CODE.",
  "validator_rule": {
    "post_fix": "zip_code"
  },
  "layer": "seed",
  "status": "active",
  "provenance": {
    "source": "docs/examples gate forms + tools/add_validators.py",
    "kind": "seed"
  },
  "scope": {
    "section_any": [
      "adres",
      "siedzib",
      "zamieszk",
      "korespondenc",
      "miejscowosc",
      "ulica"
    ],
    "section_none": [
