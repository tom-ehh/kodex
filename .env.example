# Copy to .env and adjust. All variables are optional unless noted.
COI_MAX_FILE_SIZE_BYTES=20971520
COI_MAX_BATCH_FILES=20
COI_MAX_JOBS=100

COI_JWT_ENABLED=false
# Required when COI_JWT_ENABLED=true
# COI_JWT_SECRET=change-me-at-least-32-bytes
COI_JWT_ALGORITHM=HS256
# COI_JWT_AUDIENCE=
# COI_JWT_ISSUER=

# OCR (open-weights model on EdenAI v3)
# COI_EDENAI_API_KEY=
# COI_OCR_MODEL=deepinfra/allenai/olmOCR-7B-0725-FP8

# Complexity router (basal-serve; compose sets these for the router service)
# COI_ROUTER_ENABLED=false
# COI_ROUTER_URL=http://127.0.0.1:8001
# COI_ROUTER_THRESHOLD=0.7
# COI_ROUTER_TIMEOUT_S=5
# COI_ROUTER_MAX_STATE_CHARS=12000
# Extractor model per tier (EdenAI ids, open-weights only)
# COI_TIER_SIMPLE_MODEL=deepinfra/deepseek-ai/DeepSeek-V4-Flash-0731
# COI_TIER_MEDIUM_MODEL=deepinfra/Qwen/Qwen3.6-35B-A3B
# COI_TIER_HARD_MODEL=qwen/deepseek-v4-pro-0813
# Morpheus skill store (off by default; Compose turns it on)
# COI_MORPHEUS_ENABLED=false
# COI_MORPHEUS_DB=/data/morpheus.sqlite
# COI_SKILLS_SNAPSHOT=
# COI_EPISODIC_TTL_DAYS=14
# COI_EPISODIC_MAX=20
# COI_GENERAL_MAX=50
# COI_SKILLS_MAX_PER_SECTION=5
